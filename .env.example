# Copy to .env and fill in. `docker compose` reads .env automatically.
# .env is git-ignored — never commit real credentials.

# --- Host user (files written by hf-downloader run as this uid/gid) ---
HOST_UID=1000
HOST_GID=1000

# --- Hugging Face (only needed for gated model repos) ---
HF_TOKEN=

# --- SiYuan knowledge base ---
# UI gate: Settings -> About -> Access Auth Code
SIYUAN_ACCESS_AUTH_CODE=
# API token: Settings -> About -> API Token (used by goose + companion)
SIYUAN_TOKEN=

# --- SiYuan AI Companion ---
# Bearer token clients must present to call the companion's own API
COMPANION_TOKEN=

# --- Reddit MCP (goose reddit extension; leave empty to keep it disabled) ---
# Create an app at reddit.com/prefs/apps (script type, localhost redirect).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Refresh token obtained during the OAuth dance
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=mcp-reddit/1.0