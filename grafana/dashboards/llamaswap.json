{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "GPU Core Util (DCGM)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
      "targets": [{ "expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "DCGM Util", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 95 }
            ]
          }
        }
      }
    },
    {
      "title": "VRAM Used",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 0 },
      "targets": [{ "expr": "llamaswap_gpu_memory_used_bytes / 1073741824", "legendFormat": "VRAM (GiB)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 24 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      }
    },
    {
      "title": "GPU Power Draw",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 0 },
      "targets": [{ "expr": "llamaswap_gpu_power_draw_watts", "legendFormat": "Watts", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "watt", "color": { "mode": "palette-classic" } } }
    },
    {
      "title": "GPU Core Temp",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 0 },
      "targets": [{ "expr": "llamaswap_gpu_temperature_celsius", "legendFormat": "Core °C", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 83 }
            ]
          }
        }
      }
    },
    {
      "title": "GPU Fan Speed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 0 },
      "targets": [{ "expr": "llamaswap_gpu_fan_speed_percent", "legendFormat": "Fan Speed", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "palette-classic" } } }
    },
    {
      "title": "Energy Consumed (Total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 0 },
      "targets": [{ "expr": "DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION / 3600000", "legendFormat": "Energy (Wh)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "watt-hour", "color": { "mode": "palette-classic" } } }
    },
    {
      "title": "XID Errors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 0 },
      "targets": [{ "expr": "DCGM_FI_DEV_XID_ERRORS", "legendFormat": "XID Error", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "vGPU License Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 0 },
      "targets": [{ "expr": "DCGM_FI_DEV_VGPU_LICENSE_STATUS", "legendFormat": "License", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } }
    },
    {
      "title": "VRAM Usage Breakdown (DCGM vs LlamaSwap)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "llamaswap_gpu_memory_used_bytes / 1073741824", "legendFormat": "LlamaSwap Used (GiB)", "refId": "A" },
        { "expr": "DCGM_FI_DEV_FB_USED / 1024", "legendFormat": "DCGM FB Used (GiB)", "refId": "B" },
        { "expr": "DCGM_FI_DEV_FB_FREE / 1024", "legendFormat": "DCGM FB Free (GiB)", "refId": "C" },
        { "expr": "llamaswap_gpu_memory_total_bytes / 1073741824", "legendFormat": "Total VRAM (GiB)", "refId": "D" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Thermals & VRAM Utilization %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "llamaswap_gpu_temperature_celsius", "legendFormat": "Core Temp (°C)", "refId": "A" },
        { "expr": "DCGM_FI_DEV_GPU_TEMP", "legendFormat": "DCGM Core Temp (°C)", "refId": "B" },
        { "expr": "DCGM_FI_DEV_MEMORY_TEMP", "legendFormat": "DCGM VRAM Temp (°C)", "refId": "C" },
        { "expr": "llamaswap_gpu_vram_temperature_celsius", "legendFormat": "LlamaSwap VRAM Temp (°C)", "refId": "D" },
        { "expr": "llamaswap_gpu_memory_util_percent", "legendFormat": "VRAM Util (%)", "refId": "E" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } }
    },
    {
      "title": "GPU Pipeline Workload (Compute / Memory / Video)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "DCGM Core Util (%)", "refId": "A" },
        { "expr": "llamaswap_gpu_util_percent", "legendFormat": "LlamaSwap GPU Util (%)", "refId": "B" },
        { "expr": "DCGM_FI_DEV_MEM_COPY_UTIL", "legendFormat": "Mem Copy Util (%)", "refId": "C" },
        { "expr": "DCGM_FI_DEV_ENC_UTIL", "legendFormat": "Encoder Util (%)", "refId": "D" },
        { "expr": "DCGM_FI_DEV_DEC_UTIL", "legendFormat": "Decoder Util (%)", "refId": "E" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "drawStyle": "line" } } }
    },
    {
      "title": "GPU Clocks & Interconnect Integrity (PCIe / NVLink)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "DCGM_FI_DEV_SM_CLOCK", "legendFormat": "SM Clock (MHz)", "refId": "A" },
        { "expr": "DCGM_FI_DEV_MEM_CLOCK", "legendFormat": "Mem Clock (MHz)", "refId": "B" },
        { "expr": "DCGM_FI_DEV_PCIE_REPLAY_COUNTER", "legendFormat": "PCIe Replay Counter", "refId": "C" },
        { "expr": "DCGM_FI_DEV_NVLINK_BANDWIDTH_TOTAL", "legendFormat": "NVLink Total Counter", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" } } }
    },
    {
      "title": "Host RAM & Swap Memory Allocation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "llamaswap_memory_used_bytes / 1073741824", "legendFormat": "RAM Used (GiB)", "refId": "A" },
        { "expr": "llamaswap_memory_free_bytes / 1073741824", "legendFormat": "RAM Free (GiB)", "refId": "B" },
        { "expr": "llamaswap_memory_total_bytes / 1073741824", "legendFormat": "RAM Total (GiB)", "refId": "C" },
        { "expr": "llamaswap_swap_used_bytes / 1073741824", "legendFormat": "Swap Used (GiB)", "refId": "D" },
        { "expr": "llamaswap_swap_total_bytes / 1073741824", "legendFormat": "Swap Total (GiB)", "refId": "E" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "custom": { "drawStyle": "line", "fillOpacity": 15 }
        }
      }
    },
    {
      "title": "System Load & Network Traffic Breakdown",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "expr": "llamaswap_load_average{interval=\"1m\"}", "legendFormat": "Load Avg (1m)", "refId": "A" },
        { "expr": "llamaswap_load_average{interval=\"5m\"}", "legendFormat": "Load Avg (5m)", "refId": "B" },
        { "expr": "llamaswap_load_average{interval=\"15m\"}", "legendFormat": "Load Avg (15m)", "refId": "C" },
        { "expr": "rate(llamaswap_network_bytes_total{direction=\"recv\"}[1m])", "legendFormat": "Net Received (Bytes/s)", "refId": "D" },
        { "expr": "rate(llamaswap_network_bytes_total{direction=\"sent\"}[1m])", "legendFormat": "Net Sent (Bytes/s)", "refId": "E" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" } } }
    },
    {
      "title": "CPU Heatmap / Per-Core Distribution (24 Cores)",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [{ "expr": "llamaswap_cpu_util_percent", "legendFormat": "Core {{core}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "title": "Individual CPU Core Utilization (All 24 Cores)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        { "expr": "avg(llamaswap_cpu_util_percent)", "legendFormat": "Average CPU Util (%)", "refId": "A" },
        { "expr": "llamaswap_cpu_util_percent", "legendFormat": "Core {{core}} (%)", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "drawStyle": "line" } } }
    },
    {
      "title": "Firing Prometheus Alerts",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 36 },
      "targets": [{ "expr": "ALERTS", "legendFormat": "{{alertname}} ({{alertstate}})", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" } } }
    }
  ],
  "refresh": "5s",
