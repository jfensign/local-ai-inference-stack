# Large model downloads & binaries
models/
*.gguf

# Env
.env
.DS_Store

# Runtime data (created by setup.sh / docker compose; never commit)
qdrant_data/
workspace/
comfyui/storage-*/

# Agent scratch / local state
goose/workspace/
goose/local-share/
goose/recipes/youtube-transcripts/

# Craft CLIs are host-installed binaries, staged into goose/craft-bin/
# by setup.sh — never commit them.
goose/craft-bin/*
!goose/craft-bin/.gitkeep

# pi-agent-harness: only the Dockerfile is vendored; the rest
# (node install, agent workspace) is host-local runtime state.
pi-agent-harness/*
!pi-agent-harness/Dockerfile

# Personal / foreign projects kept alongside this repo
crossref/
siyuan-skill/
.pi/