{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "System Health, Token Volume & Peak Context",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "llama_swap_up", "legendFormat": "{{upstream}}" }],
      "title": "llama-swap Health",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "count(llama_swap_model_up == 1)", "legendFormat": "Active Models" }],
      "title": "Active Models Up",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "sum(llamacpp:prompt_tokens_total)", "legendFormat": "Prompt Tokens" }],
      "title": "Total Prompt Tokens",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "sum(llamacpp:tokens_predicted_total)", "legendFormat": "Predicted Tokens" }],
      "title": "Total Predicted Tokens",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "sum(llamacpp:prompt_tokens_total) + sum(llamacpp:tokens_predicted_total)", "legendFormat": "Combined Tokens" }],
      "title": "Total Combined Tokens",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "teal", "value": null }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "id": 6,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["max"] } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "max(llamacpp:n_tokens_max)", "legendFormat": "Peak Context" }],
      "title": "Peak Context Tokens (n_tokens_max)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "id": 7,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "sum(llamacpp:n_decode_total)", "legendFormat": "Decode Calls" }],
      "title": "Total Decode Calls",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 200,
      "title": "Speeds & Current Processing Queue",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] },
          "unit": "tokens/s"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 6 },
      "id": 8,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "avg(llamacpp:prompt_tokens_seconds)", "legendFormat": "Prompt Speed" }],
      "title": "Prompt Speed (Average)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "tokens/s"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 6 },
      "id": 9,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "avg(llamacpp:predicted_tokens_seconds)", "legendFormat": "Gen Speed" }],
      "title": "Generation Speed (Average)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 6 },
      "id": 10,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "sum(llamacpp:requests_processing)", "legendFormat": "Processing" }],
      "title": "Active Processing Requests",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "yellow", "value": null }] },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 6 },
      "id": 11,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "sum(llamacpp:prompt_seconds_total) + sum(llamacpp:tokens_predicted_seconds_total)", "legendFormat": "Processing Time" }],
      "title": "Total Inference Processing Time",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 300,
      "title": "Context Size & Token Dynamics Over Time",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "id": 12,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "pluginVersion": "10.0.0",
      "targets": [
        { "expr": "llamacpp:n_tokens_max", "legendFormat": "Max Context: {{model}}" }
      ],
      "title": "Peak Context Tokens Over Time (llamacpp:n_tokens_max)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "tokens/s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "id": 13,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "pluginVersion": "10.0.0",
      "targets": [
        { "expr": "rate(llamacpp:tokens_predicted_total[1m])", "legendFormat": "Predicted Rate: {{model}}" },
        { "expr": "rate(llamacpp:prompt_tokens_total[1m])", "legendFormat": "Prompt Rate: {{model}}" }
      ],
      "title": "Token Evaluation Rate (Tokens/sec)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 400,
      "title": "llama.cpp Engine Operations & Queue State",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "short" } },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 20 },
      "id": 14,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "pluginVersion": "10.0.0",
      "targets": [
        { "expr": "llamacpp:requests_processing", "legendFormat": "Processing: {{model}}" },
        { "expr": "llamacpp:requests_deferred", "legendFormat": "Deferred: {{model}}" }
      ],
      "title": "Requests Queue (Processing vs Deferred)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "ops" } },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 20 },
      "id": 15,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "pluginVersion": "10.0.0",
      "targets": [
        { "expr": "rate(llamacpp:n_decode_total[1m])", "legendFormat": "Decode Calls/s: {{model}}" }
      ],
      "title": "Decode Operations Rate (llama_decode/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "short" } },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 20 },
      "id": 16,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "pluginVersion": "10.0.0",
      "targets": [
        { "expr": "llamacpp:n_busy_slots_per_decode", "legendFormat": "Busy Slots: {{model}}" }
      ],
      "title": "Busy Slots Per Decode",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 500,
      "title": "Model Lifecycle & Exporter Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "displayMode": "basic" } } },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 28 },
      "id": 17,
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true },
      "pluginVersion": "10.0.0",
      "targets": [
        { "expr": "llama_swap_model_info", "format": "table", "instant": true, "legendFormat": "" }
      ],
      "title": "Model Inventory & Lifecycle State",
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "s" } },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 28 },
      "id": 18,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "pluginVersion": "10.0.0",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(llama_swap_scrape_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95 Scrape Latency" }
      ],
      "title": "Exporter Scrape Duration (p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "short" } },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 28 },
      "id": 19,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "pluginVersion": "10.0.0",
      "targets": [
        { "expr": "rate(llama_swap_scrape_errors_total[5m])", "legendFormat": "Errors/s: {{upstream}}" }
      ],
      "title": "Scrape Errors Rate",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["llama-swap", "llamacpp", "prometheus"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "value": "default" },
        "hide": 0,
        "label": "Data Source",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "llama-swap & llama.cpp Unified Telemetry",
  "uid": "llama-swap-unified",
  "version": 1
}
